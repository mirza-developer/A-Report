<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Strict warnings (CI) are on for AReport.Core only until this project has had a green CI run; then remove this line. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>AReport.Designer</AssemblyName>
    <RootNamespace>AReport.Designer</RootNamespace>
    <IsPackable>false</IsPackable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <Description>Windows designer for A-Report .art files.</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AReport.Designer.ViewModels\AReport.Designer.ViewModels.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\icon.png" Link="Assets\icon.png" />
  </ItemGroup>
</Project>
