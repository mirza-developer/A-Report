<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Design tokens: the single source of values. Keep in sync with DESIGN.md section 2 (checked by DesignSystemTests). -->

    <!-- Colour -->
    <Color x:Key="Color.Primary">#1F3A5F</Color>
    <Color x:Key="Color.PrimaryHover">#274B7A</Color>
    <Color x:Key="Color.PrimaryPressed">#17304F</Color>
    <Color x:Key="Color.Accent">#E05A47</Color>
    <Color x:Key="Color.Selection">#2563EB</Color>
    <Color x:Key="Color.Background">#F3F4F6</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.Canvas">#E5E7EB</Color>
    <Color x:Key="Color.Border">#D1D5DB</Color>
    <Color x:Key="Color.BorderStrong">#8A94A3</Color>
    <Color x:Key="Color.TextPrimary">#111827</Color>
    <Color x:Key="Color.TextSecondary">#4B5563</Color>
    <Color x:Key="Color.TextDisabled">#9CA3AF</Color>
    <Color x:Key="Color.TextOnPrimary">#FFFFFF</Color>
    <Color x:Key="Color.Danger">#B91C1C</Color>
    <Color x:Key="Color.Success">#15803D</Color>
    <Color x:Key="Color.Warning">#B45309</Color>
    <Color x:Key="Color.Guide">#93C5FD</Color>

    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Color.PrimaryHover}" />
    <SolidColorBrush x:Key="Brush.PrimaryPressed" Color="{StaticResource Color.PrimaryPressed}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Selection}" />
    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Canvas" Color="{StaticResource Color.Canvas}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}" />
    <SolidColorBrush x:Key="Brush.TextOnPrimary" Color="{StaticResource Color.TextOnPrimary}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Guide" Color="{StaticResource Color.Guide}" />

    <!-- Typography -->
    <FontFamily x:Key="Font.Family">Segoe UI Variable, Segoe UI</FontFamily>
    <sys:Double x:Key="Font.Size.Caption">12</sys:Double>
    <sys:Double x:Key="Font.Size.Body">13</sys:Double>
    <sys:Double x:Key="Font.Size.Subtitle">15</sys:Double>
    <sys:Double x:Key="Font.Size.Title">20</sys:Double>

    <!-- Spacing (4 px grid) -->
    <sys:Double x:Key="Space.1">4</sys:Double>
    <sys:Double x:Key="Space.2">8</sys:Double>
    <sys:Double x:Key="Space.3">12</sys:Double>
    <sys:Double x:Key="Space.4">16</sys:Double>
    <sys:Double x:Key="Space.6">24</sys:Double>
    <sys:Double x:Key="Space.8">32</sys:Double>
    <Thickness x:Key="Inset.1">4</Thickness>
    <Thickness x:Key="Inset.2">8</Thickness>
    <Thickness x:Key="Inset.3">12</Thickness>
    <Thickness x:Key="Inset.4">16</Thickness>
    <Thickness x:Key="Inset.6">24</Thickness>
    <Thickness x:Key="Inset.8">32</Thickness>
    <Thickness x:Key="Inset.H2">8,0</Thickness>
    <Thickness x:Key="Inset.H3">12,0</Thickness>

    <!-- Sizes and shape -->
    <sys:Double x:Key="Size.Control">32</sys:Double>
    <sys:Double x:Key="Size.Toolbar">48</sys:Double>
    <sys:Double x:Key="Size.StatusBar">28</sys:Double>
    <sys:Double x:Key="Size.PropertiesWidth">300</sys:Double>
    <sys:Double x:Key="Size.ToolboxWide">148</sys:Double>
    <sys:Double x:Key="Size.ToolboxCompact">56</sys:Double>
    <sys:Double x:Key="Size.Handle">8</sys:Double>
    <sys:Double x:Key="Size.CanvasMin">320</sys:Double>
    <CornerRadius x:Key="Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Radius.Panel">6</CornerRadius>
</ResourceDictionary>
