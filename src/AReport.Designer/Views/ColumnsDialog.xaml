<Window x:Class="AReport.Designer.Views.ColumnsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AReport.Designer.Views"
        Title="Table columns" Width="760" Height="420" MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background}">
    <Grid Margin="{StaticResource Inset.4}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="{StaticResource Inset.1}">
            <TextBlock Text="Table columns" Style="{StaticResource Text.Title}" />
            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                       Text="Binding is a field of each row (for example Price or Product.Name), or # for the row number. Weight sets the relative width. Format is a .NET format such as N2 or yyyy-MM-dd." />
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="Grid" Margin="{StaticResource Inset.1}" AutoGenerateColumns="False"
                  ItemsSource="{Binding Columns, RelativeSource={RelativeSource AncestorType=Window}}"
                  AutomationProperties.Name="Columns of the table">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Header" Binding="{Binding Header}" Width="2*" />
                <DataGridTextColumn Header="Binding" Binding="{Binding Binding}" Width="2*" />
                <DataGridTextColumn Header="Weight" Binding="{Binding Weight}" Width="*" />
                <DataGridComboBoxColumn Header="Align" SelectedItemBinding="{Binding Alignment}"
                                        ItemsSource="{x:Static local:ColumnsDialog.AlignmentValues}" Width="*" />
                <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="{StaticResource Inset.1}">
            <Button Content="Cancel" IsCancel="True" Margin="{StaticResource Inset.1}" />
            <Button Content="OK" IsDefault="True" Style="{StaticResource Button.Primary}" Margin="{StaticResource Inset.1}" Click="OnOk" />
        </StackPanel>
    </Grid>
</Window>
